# ==========================================
# KisanSetu Prototype Environment Configuration
# ==========================================

# Server Port
PORT=3000
NODE_ENV=development

# ------------------------------------------
# 1. Google Gemini API (Vertex AI / Google AI Studio)
# ------------------------------------------
# Used for: Autonomous Multi-Turn AI Bargaining Agent & Multilingual Voice Query Parser
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------
# 2. OpenWeatherMap API
# ------------------------------------------
# Used for: Hyper-local Mandi Weather Telemetry, Humidity & Spoilage Risk Forecasting in AI Advisory
# Get a free key at: https://openweathermap.org/api (Current Weather & 5-Day Forecast free tier)
OPENWEATHER_API_KEY=your_openweather_key

# ------------------------------------------
# 3. Data.gov.in / Agmarknet Market Data API
# ------------------------------------------
# Used for: Live Government Mandi Daily Modal Rates and Arrivals Feed
# Get a free key at: https://data.gov.in (Register & create API key for Agricultural Mandi Commodity Resource)
DATA_GOV_IN_API_KEY=your_data_gov_in_key
